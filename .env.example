# ===============================
# CoachUp API - Environment Variables
# ===============================
#
# Copy this file to .env and fill in your values
# This same file works for both local development and Docker production
#

# ===============================
# Database
# ===============================
# Local dev: connects to Docker postgres on localhost:5487
# Docker prod: overridden in docker-compose.yml to use internal network
DATABASE_URL="postgresql://postgres:your_secure_password_here@localhost:5487/coachup?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# ===============================
# JWT Authentication
# ===============================
JWT_SECRET="your-secure-jwt-secret-change-in-production"

# ===============================
# Server Configuration
# ===============================
PORT=3847
NODE_ENV=development

# ===============================
# Frontend URL (for CORS)
# ===============================
# Local dev: your local frontend
# Production: your deployed frontend URL
FRONTEND_URL=http://localhost:3846

# ===============================
# Stripe (Payment Processing)
# ===============================
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Price IDs from Stripe Dashboard > Products
STRIPE_PRICE_STARTER=price_starter_id
STRIPE_PRICE_PRO=price_pro_id
STRIPE_PRICE_PREMIUM=price_premium_id
STRIPE_PRICE_REGENERATION=price_regeneration_id

# ===============================
# Kie.ai (Video/Image Generation)
# ===============================
# Get your API key at: https://kie.ai/api-key
KIE_AI_API_KEY=your_kie_ai_api_key

# ===============================
# imgBB (Image Hosting)
# ===============================
# Get your free API key at: https://api.imgbb.com/
IMGBB_API_KEY=your_imgbb_api_key

# ===============================
# Meta Business API (Instagram/Facebook Ads)
# ===============================
# Set to 'true' to use stub mode (no real API calls)
META_STUB_MODE=false

# Get from Meta Business Suite > Settings > Business Portfolio
META_BUSINESS_ID=your_business_portfolio_id

# Generate from Meta Business Suite > Settings > System Users
META_ACCESS_TOKEN=your_meta_access_token

# Maximum number of ad accounts to create
META_ACCOUNT_LIMIT=5
